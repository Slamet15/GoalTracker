<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,0,24">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Summary cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Active Goals" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <TextBlock x:Name="ActiveGoalsCount" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Tasks Today" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <TextBlock x:Name="TodayTasksCount" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Habits Done" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <TextBlock x:Name="HabitsDoneCount" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Time Today" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <TextBlock x:Name="TimeTodayText" Text="0h 0m" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent goals -->
            <TextBlock Text="Active Goals" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
            <ItemsControl x:Name="RecentGoals">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding Title}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <ProgressBar Grid.Row="2" Value="{Binding ProgressPercent}" Maximum="100"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
