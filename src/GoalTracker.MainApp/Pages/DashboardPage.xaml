<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#141414">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,0,24">

            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>

            <!-- Stat cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ACTIVE GOALS" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock x:Name="ActiveGoalsCount" Text="0"
                                   FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TASKS TODAY" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock x:Name="TodayTasksCount" Text="0"
                                   FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="HABITS DONE" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock x:Name="HabitsDoneCount" Text="0"
                                   FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TIME TODAY" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock x:Name="TimeTodayText" Text="0h 0m"
                                   FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active Goals -->
            <StackPanel Spacing="12">
                <TextBlock Text="GOALS" Style="{StaticResource SectionLabel}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RecentGoalsPanel"
                                Orientation="Horizontal" Spacing="12"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Today section -->
            <StackPanel Spacing="12">
                <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}"/>
                <ItemsControl x:Name="TodayItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6">
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="#C8C8C8"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
