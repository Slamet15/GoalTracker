<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.HabitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Habits" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button HorizontalAlignment="Right" Content="+ New Habit" Click="AddHabit_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ListView Grid.Row="1" x:Name="HabitsList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Check today button -->
                            <Button Grid.Column="0" Tag="{Binding}" Click="ToggleHabit_Click"
                                    Width="36" Height="36" CornerRadius="18">
                                <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                            </Button>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Emoji}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Frequency}" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>

                            <!-- Streak -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentStreak}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="streak" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>

                            <Button Grid.Column="3" Tag="{Binding}" Click="DeleteHabit_Click"
                                    Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
