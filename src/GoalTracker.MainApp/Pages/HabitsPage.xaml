<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.HabitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#141414">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Habits" Style="{StaticResource PageTitle}"/>
            <Button HorizontalAlignment="Right" Content="+ New Habit"
                    Click="AddHabit_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ListView Grid.Row="1" x:Name="HabitsList" SelectionMode="None"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Toggle circle -->
                            <Button Grid.Column="0"
                                    Tag="{Binding}" Click="ToggleHabit_Click"
                                    Width="32" Height="32" CornerRadius="16"
                                    Background="#252525"
                                    BorderBrush="#3A3A3A" BorderThickness="1.5"
                                    Padding="0">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#3D8EF0"/>
                            </Button>

                            <!-- Emoji + title + frequency -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Emoji}" FontSize="14"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E8E8E8"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Frequency}"
                                           FontSize="11" Foreground="#444444"/>
                            </StackPanel>

                            <!-- Streak -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding CurrentStreak}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#E8E8E8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="day streak"
                                           FontSize="10" Foreground="#444444"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center">
                                <Button Tag="{Binding}" Click="EditHabit_Click"
                                        Style="{StaticResource IconButton}">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="#555555"/>
                                </Button>
                                <Button Tag="{Binding}" Click="DeleteHabit_Click"
                                        Style="{StaticResource IconButton}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#555555"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
