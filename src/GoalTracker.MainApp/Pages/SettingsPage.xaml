<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#141414">

    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="600">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>

            <!-- Data -->
            <TextBlock Text="DATA" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DataPathText" FontSize="12"
                               Foreground="#555555" TextWrapping="Wrap"/>
                    <Button Content="Open Data Folder" Click="OpenDataFolder_Click"
                            Background="#252525" BorderBrush="#2A2A2A" Foreground="#E8E8E8"/>
                </StackPanel>
            </Border>

            <!-- Widget -->
            <TextBlock Text="WIDGET" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Opacity" FontSize="12" Foreground="#E8E8E8"
                                   VerticalAlignment="Center" Width="80"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0"
                                StepFrequency="0.05" Width="200"
                                ValueChanged="OpacitySlider_Changed"/>
                        <TextBlock x:Name="OpacityLabel" FontSize="12"
                                   Foreground="#666666" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle"
                                  Header="Launch widget on Windows startup"
                                  Toggled="StartupToggle_Toggled"/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="App Theme" FontSize="12" Foreground="#E8E8E8"
                               VerticalAlignment="Center" Width="100"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_Changed"
                              Background="#252525" BorderBrush="#2A2A2A">
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
