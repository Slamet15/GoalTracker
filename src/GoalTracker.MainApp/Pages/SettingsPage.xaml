<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="600">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Data -->
            <TextBlock Text="Data" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DataPathText" Opacity="0.7" TextWrapping="Wrap"/>
                    <Button Content="Open Data Folder" Click="OpenDataFolder_Click"/>
                </StackPanel>
            </Border>

            <!-- Widget -->
            <TextBlock Text="Widget" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Opacity" VerticalAlignment="Center" Width="80"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" StepFrequency="0.05"
                                Width="200" ValueChanged="OpacitySlider_Changed"/>
                        <TextBlock x:Name="OpacityLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Header="Launch widget on Windows startup"
                                  Toggled="StartupToggle_Toggled"/>
                </StackPanel>
            </Border>

            <!-- Theme -->
            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Theme" VerticalAlignment="Center" Width="80"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_Changed">
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
