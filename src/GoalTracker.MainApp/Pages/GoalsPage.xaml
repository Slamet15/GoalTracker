<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#141414">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <TextBlock Text="Goals" Style="{StaticResource PageTitle}"/>
            <Button HorizontalAlignment="Right" Content="+ New Goal"
                    Click="AddGoal_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <!-- Goal cards -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="GoalsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="2"
                                       ItemWidth="340"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top: color bar + category + actions -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Palette color pill -->
                                    <Border Grid.Column="0"
                                            Width="4" CornerRadius="2"
                                            Background="{Binding PaletteColor}"
                                            Margin="0,0,10,0"/>

                                    <!-- Category chip -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryEmoji}" FontSize="11"/>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="11"
                                                   Foreground="#555555"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button Tag="{Binding}" Click="EditGoal_Click"
                                                Style="{StaticResource IconButton}">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="#555555"/>
                                        </Button>
                                        <Button Tag="{Binding}" Click="DeleteGoal_Click"
                                                Style="{StaticResource IconButton}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#555555"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Title -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Title}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#E8E8E8"
                                           TextWrapping="Wrap"/>

                                <!-- Description -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#555555"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Progress -->
                                <Grid Grid.Row="3" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="Progress" FontSize="10"
                                                   Foreground="#3A3A3A"/>
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#E8E8E8">
                                            <Run Text="{Binding ProgressPercent}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </Grid>
                                    <ProgressBar Grid.Row="1"
                                                 Value="{Binding ProgressPercent}"
                                                 Style="{StaticResource SlimProgress}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
