<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Goals" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button HorizontalAlignment="Right" Content="+ New Goal" Click="AddGoal_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="GoalsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Color accent bar -->
                                <Border Grid.Column="0" CornerRadius="4"
                                        Background="{Binding Color}"/>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding Description}" Opacity="0.7"
                                               TextWrapping="Wrap" MaxLines="2"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Width="200"/>
                                        <TextBlock Opacity="0.7">
                                            <Run Text="{Binding ProgressPercent}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button Tag="{Binding}" Click="EditGoal_Click" Content="&#xE70F;"
                                            FontFamily="Segoe MDL2 Assets"/>
                                    <Button Tag="{Binding}" Click="DeleteGoal_Click" Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
