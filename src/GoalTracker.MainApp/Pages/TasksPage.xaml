<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#141414">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Tasks" Style="{StaticResource PageTitle}"/>
            <Button HorizontalAlignment="Right" Content="+ New Task"
                    Click="AddTask_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Today -->
            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}"/>
                <ListView x:Name="TodayList" SelectionMode="None" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Priority dot -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="#3D8EF0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="13" Foreground="#E8E8E8"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <CheckBox IsChecked="{Binding IsCompleted}"
                                                  Tag="{Binding}" Click="Task_Checked"
                                                  Width="24" Height="24"/>
                                        <Button Tag="{Binding}" Click="DeleteTask_Click"
                                                Style="{StaticResource IconButton}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="#555555"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- All tasks -->
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="ALL TASKS" Style="{StaticResource SectionLabel}"/>
                <ListView x:Name="AllList" SelectionMode="None" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Priority indicator -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="#2A2A2A"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13" Foreground="#E8E8E8"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Priority}"
                                                   FontSize="10" Foreground="#444444"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <CheckBox IsChecked="{Binding IsCompleted}"
                                                  Tag="{Binding}" Click="Task_Checked"
                                                  Width="24" Height="24"/>
                                        <Button Tag="{Binding}" Click="DeleteTask_Click"
                                                Style="{StaticResource IconButton}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="#555555"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
