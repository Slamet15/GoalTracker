<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoalTracker.MainApp.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Categories" Style="{StaticResource TitleTextBlockStyle}" Foreground="#E8E8E8"/>
            <Button HorizontalAlignment="Right" Content="+ New Category"
                    Click="AddCategory_Click" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <ListView Grid.Row="1" x:Name="CategoriesList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1C1C1C" CornerRadius="8"
                            Padding="16,12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color dot -->
                            <Ellipse Grid.Column="0" Width="12" Height="12"
                                     Fill="{Binding Color}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Emoji -->
                            <TextBlock Grid.Column="1" Text="{Binding Emoji}"
                                       FontSize="16" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <!-- Name -->
                            <TextBlock Grid.Column="2" Text="{Binding Name}"
                                       FontSize="13" Foreground="#E8E8E8"
                                       VerticalAlignment="Center"/>

                            <!-- Actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                <Button Tag="{Binding}" Click="EditCategory_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="#666666"/>
                                </Button>
                                <Button Tag="{Binding}" Click="DeleteCategory_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Width="32" Height="32">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#666666"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
