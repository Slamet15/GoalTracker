<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GoalTracker.MainApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Dark Minimal Theme Tokens ── -->
            <SolidColorBrush x:Key="AppBackground"    Color="#141414"/>
            <SolidColorBrush x:Key="AppSurface"       Color="#1C1C1C"/>
            <SolidColorBrush x:Key="AppSurfaceHover"  Color="#242424"/>
            <SolidColorBrush x:Key="AppBorder"        Color="#2A2A2A"/>
            <SolidColorBrush x:Key="AppTextPrimary"   Color="#E8E8E8"/>
            <SolidColorBrush x:Key="AppTextSecondary" Color="#666666"/>
            <SolidColorBrush x:Key="AppTextMuted"     Color="#3A3A3A"/>
            <SolidColorBrush x:Key="AppAccent"        Color="#3D8EF0"/>

            <!-- ── Card style ── -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background"    Value="#1C1C1C"/>
                <Setter Property="BorderBrush"   Value="#2A2A2A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"  Value="8"/>
                <Setter Property="Padding"       Value="16,12"/>
            </Style>

            <!-- ── Section label ── -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize"       Value="10"/>
                <Setter Property="FontWeight"     Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="150"/>
                <Setter Property="Foreground"     Value="#3A3A3A"/>
                <Setter Property="Margin"         Value="0,0,0,8"/>
            </Style>

            <!-- ── Page title ── -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#E8E8E8"/>
            </Style>

            <!-- ── Slim progress bar ── -->
            <Style x:Key="SlimProgress" TargetType="ProgressBar">
                <Setter Property="Height"      Value="3"/>
                <Setter Property="Minimum"     Value="0"/>
                <Setter Property="Maximum"     Value="100"/>
                <Setter Property="Background"  Value="#252525"/>
                <Setter Property="Foreground"  Value="#3D8EF0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>

            <!-- ── Icon button ── -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background"   Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width"        Value="32"/>
                <Setter Property="Height"       Value="32"/>
                <Setter Property="Padding"      Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
