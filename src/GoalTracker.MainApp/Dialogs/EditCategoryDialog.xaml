<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GoalTracker.MainApp.Dialogs.EditCategoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Category"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="340">

        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. Health, Career, Finance"/>

        <TextBox x:Name="EmojiBox" Header="Emoji" PlaceholderText="e.g. 🏃" MaxLength="4"/>

        <!-- Color palette -->
        <StackPanel Spacing="8">
            <TextBlock Text="Color" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
            <StackPanel Orientation="Horizontal" Spacing="8" x:Name="PalettePanel">
                <!-- Circles are created in code-behind -->
            </StackPanel>
        </StackPanel>

    </StackPanel>
</ContentDialog>
