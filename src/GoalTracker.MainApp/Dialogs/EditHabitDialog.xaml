<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GoalTracker.MainApp.Dialogs.EditHabitDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Habit"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" Width="360">
        <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="Habit title"/>
        <TextBox x:Name="EmojiBox" Header="Emoji" PlaceholderText="e.g. 🏃" MaxLength="4"/>
        <TextBox x:Name="DescBox" Header="Description" PlaceholderText="Optional description"/>
        <ComboBox x:Name="FrequencyCombo" Header="Frequency">
            <ComboBoxItem Content="Daily" IsSelected="True"/>
            <ComboBoxItem Content="Weekly"/>
        </ComboBox>
    </StackPanel>
</ContentDialog>
