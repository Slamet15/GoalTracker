<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GoalTracker.MainApp.Dialogs.EditGoalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Goal"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" Width="400">
        <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="Goal title"/>
        <TextBox x:Name="DescBox" Header="Description" PlaceholderText="Optional description"
                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
        <TextBox x:Name="CategoryBox" Header="Category" PlaceholderText="e.g. Health, Career"/>
        <TextBox x:Name="ColorBox" Header="Accent Color (hex)" PlaceholderText="#0078D4"/>
        <DatePicker x:Name="DueDatePicker" Header="Due Date (optional)"/>
        <ToggleSwitch x:Name="UseTasksToggle" Header="Calculate progress from linked tasks"
                      IsOn="True"/>
        <Slider x:Name="ManualProgress" Header="Manual Progress %" Minimum="0" Maximum="100"
                StepFrequency="5"
                Visibility="{x:Bind ManualProgressVisibility, Mode=OneWay}"/>
    </StackPanel>
</ContentDialog>
