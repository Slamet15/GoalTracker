<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GoalTracker.MainApp.Dialogs.EditGoalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Goal"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="14" Width="420" Padding="0,4,0,4">

            <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="What do you want to achieve?"/>

            <TextBox x:Name="DescBox" Header="Description"
                     PlaceholderText="Optional description"
                     AcceptsReturn="True" Height="72" TextWrapping="Wrap"/>

            <!-- Color palette -->
            <StackPanel Spacing="6">
                <TextBlock Text="Color" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                <StackPanel x:Name="PalettePanel" Orientation="Horizontal" Spacing="8"/>
            </StackPanel>

            <!-- Category dropdown -->
            <ComboBox x:Name="CategoryCombo" Header="Category"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="— No category —"/>

            <DatePicker x:Name="DueDatePicker" Header="Due Date (optional)"/>

            <!-- Progress mode -->
            <ComboBox x:Name="ProgressModeCombo" Header="Track progress by"
                      SelectionChanged="ProgressModeCombo_Changed">
                <ComboBoxItem Content="Milestones"/>
                <ComboBoxItem Content="Linked tasks"/>
                <ComboBoxItem Content="Manual %"/>
            </ComboBox>

            <Slider x:Name="ManualProgress" Header="Manual Progress %"
                    Minimum="0" Maximum="100" StepFrequency="5"
                    Visibility="Collapsed"/>

            <!-- Milestones editor -->
            <StackPanel x:Name="MilestonesPanel" Spacing="8">
                <Grid>
                    <TextBlock Text="Milestones"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <TextBlock x:Name="TotalPercentLabel" FontSize="11"
                                   Opacity="0.5" VerticalAlignment="Center"/>
                        <Button Content="+ Add" Click="AddMilestone_Click"
                                Height="28" FontSize="11" Padding="10,0"/>
                    </StackPanel>
                </Grid>

                <ListView x:Name="MilestonesList" SelectionMode="None" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="6" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="Milestone title" Height="36"/>
                                <NumberBox Grid.Column="1"
                                           Value="{Binding CompletionPercent, Mode=TwoWay}"
                                           Minimum="1" Maximum="100"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="5" Height="36"
                                           Header=""/>
                                <Button Grid.Column="2" Tag="{Binding}"
                                        Click="DeleteMilestone_Click"
                                        Width="32" Height="36"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#666"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="PercentWarning"
                           Text="⚠ Total exceeds 100%"
                           FontSize="11" Foreground="#FF6B35"
                           Visibility="Collapsed"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
