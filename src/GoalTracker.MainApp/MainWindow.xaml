<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoalTracker.MainApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Goal Tracker">

    <NavigationView x:Name="NavView"
                    PaneTitle="Goal Tracker"
                    IsSettingsVisible="True"
                    SelectionChanged="NavView_SelectionChanged"
                    Loaded="NavView_Loaded">

        <NavigationView.MenuItems>
            <NavigationViewItem Tag="dashboard" Content="Dashboard">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="goals" Content="Goals">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7C1;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="tasks" Content="Tasks">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D5;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="habits" Content="Habits">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE895;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="activity" Content="Activity Log">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE823;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" Padding="16"/>
    </NavigationView>
</Window>
