<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoalTracker.Widget.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GoalTracker.Widget.Views">

    <Grid Background="Transparent">
        <Border CornerRadius="12" Padding="1">
            <Border.Background>
                <SolidColorBrush Color="#1A1A2E" Opacity="0.85"/>
            </Border.Background>

            <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drag handle -->
                <Grid Grid.Row="0" x:Name="DragHandle" PointerPressed="DragHandle_PointerPressed"
                      Padding="0,0,0,4">
                    <TextBlock Text="Goal Tracker" Foreground="White" Opacity="0.5"
                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button x:Name="CollapseBtn" Click="CollapseBtn_Click"
                                Width="24" Height="24" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE96D;" FontSize="10" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sections (hidden when collapsed) -->
                <StackPanel x:Name="ContentPanel" Grid.Row="1" Grid.RowSpan="4" Spacing="8">
                    <views:GoalsSectionView/>
                    <views:TasksSectionView/>
                    <views:ActivitySectionView/>
                    <views:HabitsSectionView/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
