<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoalTracker.Widget.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GoalTracker.Widget.Views">

    <Grid Background="#141414">

        <Grid Padding="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Grid Grid.Row="0"
                  x:Name="DragHandle"
                  PointerPressed="DragHandle_PointerPressed"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="GOAL TRACKER"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="150"
                           Foreground="#3A3A3A"
                           VerticalAlignment="Center"/>

                <!-- Minimal control buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">

                    <Button x:Name="CollapseBtn" Click="CollapseBtn_Click"
                            Width="24" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="4">
                        <FontIcon x:Name="CollapseIcon" Glyph="&#xE96D;"
                                  FontSize="8" Foreground="#3A3A3A"/>
                    </Button>

                    <Button x:Name="PinBtn" Click="PinBtn_Click"
                            Width="24" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="4">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE840;"
                                  FontSize="8" Foreground="#3D8EF0"/>
                    </Button>

                    <Button x:Name="HideBtn" Click="HideBtn_Click"
                            Width="24" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="4">
                        <FontIcon Glyph="&#xE921;"
                                  FontSize="8" Foreground="#3A3A3A"/>
                    </Button>

                    <Button x:Name="CloseBtn" Click="CloseBtn_Click"
                            Width="24" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="4">
                        <FontIcon Glyph="&#xE711;"
                                  FontSize="8" Foreground="#3A3A3A"/>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- ── Content ── -->
            <StackPanel x:Name="ContentPanel" Grid.Row="1" Spacing="20">
                <views:GoalsSectionView/>
                <views:TasksSectionView/>
                <views:ActivitySectionView/>
                <views:HabitsSectionView/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
