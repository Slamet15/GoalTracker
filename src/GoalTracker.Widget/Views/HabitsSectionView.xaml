<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GoalTracker.Widget.Views.HabitsSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">

        <TextBlock Text="HABITS"
                   FontSize="10" FontWeight="SemiBold"
                   CharacterSpacing="150"
                   Foreground="#3A3A3A"/>

        <ItemsControl x:Name="HabitsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="10" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toggle dot button -->
                        <Button Grid.Column="0"
                                Tag="{Binding}"
                                Click="Habit_Click"
                                Width="14" Height="14"
                                Padding="0"
                                CornerRadius="7"
                                Background="#252525"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1.5"
                                VerticalAlignment="Center"/>

                        <!-- Emoji + title -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Emoji}" FontSize="11"/>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="12"
                                       Foreground="#C8C8C8"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Streak -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentStreak}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"/>
                            <TextBlock Text="d"
                                       FontSize="10"
                                       Foreground="#333333"/>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
