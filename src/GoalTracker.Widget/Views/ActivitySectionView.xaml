<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GoalTracker.Widget.Views.ActivitySectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">

        <TextBlock Text="ACTIVITY"
                   FontSize="10" FontWeight="SemiBold"
                   CharacterSpacing="150"
                   Foreground="#3A3A3A"/>

        <!-- Running timer pill -->
        <Border x:Name="RunningBorder"
                Visibility="Collapsed"
                Background="#1C1C1C"
                CornerRadius="4"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pulsing green dot -->
                <Ellipse Grid.Column="0"
                         Width="5" Height="5"
                         Fill="#4CAF50"
                         VerticalAlignment="Center"
                         Margin="0,0,7,0"/>

                <TextBlock Grid.Column="1"
                           x:Name="RunningLabel"
                           FontSize="11"
                           Foreground="#C8C8C8"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        x:Name="StopBtn"
                        Content="stop"
                        Click="Stop_Click"
                        Height="18"
                        FontSize="10"
                        Padding="6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#555555"
                        Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- Activity entries -->
        <ItemsControl x:Name="ActivityList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="12"
                                   Foreground="#C8C8C8"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="#444444">
                            <Run Text="{Binding Duration.Hours}"/>
                            <Run Text="h "/>
                            <Run Text="{Binding Duration.Minutes}"/>
                            <Run Text="m"/>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
