<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GoalTracker.Widget.Views.GoalsSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Slim dark progress bar style -->
        <Style x:Key="MinimalProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#3D8EF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8">

        <TextBlock Text="GOALS"
                   FontSize="10" FontWeight="SemiBold"
                   CharacterSpacing="150"
                   Foreground="#3A3A3A"/>

        <ItemsControl x:Name="GoalsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="5" Margin="0,0,0,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontSize="12"
                                       Foreground="#E8E8E8"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="1"
                                       FontSize="11"
                                       Foreground="#555555"
                                       Margin="8,0,0,0">
                                <Run Text="{Binding ProgressPercent}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>

                        <ProgressBar Value="{Binding ProgressPercent}"
                                     Style="{StaticResource MinimalProgressBar}"/>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
